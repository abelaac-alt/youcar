<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F13">

    <LinearLayout
        android:id="@+id/browser_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#14161B"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CarView"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="19sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="#9FA3AD"
                    android:textSize="9sp"
                    android:letterSpacing="0.13"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/voice_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Búsqueda por voz"
                android:padding="12dp"
                android:src="@drawable/ic_mic"/>
            <ImageButton
                android:id="@+id/star_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bookmark"
                android:padding="12dp"
                android:src="@drawable/ic_star"/>
            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#191C22"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="10dp">
            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="42dp" android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="@string/back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"/>
            <ImageButton
                android:id="@+id/forward_button"
                android:layout_width="42dp" android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="@string/forward"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"/>
            <ImageButton
                android:id="@+id/home_button"
                android:layout_width="42dp" android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="@string/home"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"/>
            <ImageButton
                android:id="@+id/reload_button"
                android:layout_width="42dp" android:layout_height="48dp"
                android:padding="12dp"
                android:contentDescription="@string/refresh"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reload"/>
            <EditText
                android:id="@+id/address_field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:background="@drawable/rounded_input"
                android:hint="@string/address_hint"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888E99"
                android:textSize="13sp"/>
            <ImageButton
                android:id="@+id/go_button"
                android:layout_width="46dp" android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/go"
                android:padding="12dp"
                android:background="@drawable/rounded_button"
                android:src="@drawable/ic_search"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="gone"
            android:max="100"
            android:progressTint="#F43F5E"
            android:progressBackgroundTint="#25282E"/>
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"/>
        <TextView
            android:id="@+id/safety_label"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:gravity="center"
            android:background="#14161B"
            android:text="@string/stationary"
            android:textColor="#B8BDC8"
            android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
